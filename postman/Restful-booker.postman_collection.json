        {
          "name": "Create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique test data for every run\r\nconst firstname = pm.variables.replaceIn(\"{{$randomFirstName}}\");\r\nconst lastname = pm.variables.replaceIn(\"{{$randomLastName}}\");\r\nconst totalprice = Math.floor(Math.random() * 900) + 100; // 100–999\r\n\r\nconst checkin = new Date();\r\ncheckin.setDate(checkin.getDate() + 30);   // 30 days from today\r\nconst checkout = new Date(checkin);\r\ncheckout.setDate(checkout.getDate() + 5);  // 5 nights\r\nconst toDate = d => d.toISOString().slice(0, 10); // YYYY-MM-DD\r\n\r\npm.variables.set(\"firstname\", firstname);\r\npm.variables.set(\"lastname\", lastname);\r\npm.variables.set(\"totalprice\", totalprice);\r\npm.variables.set(\"checkin\", toDate(checkin));\r\npm.variables.set(\"checkout\", toDate(checkout));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", () => {\r\n    pm.response.to.have.status(201); // known bug: API returns 200\r\n});\r\n\r\npm.test(\"Response contains a numeric booking ID\", () => {\r\n    const body = pm.response.json();\r\n    pm.expect(body.bookingid).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"Saved booking matches the request\", () => {\r\n    const body = pm.response.json();\r\n    pm.expect(body.booking.firstname).to.eql(pm.variables.get(\"firstname\"));\r\n    pm.expect(body.booking.lastname).to.eql(pm.variables.get(\"lastname\"));\r\n    pm.expect(body.booking.totalprice).to.eql(Number(pm.variables.get(\"totalprice\")));\r\n    pm.expect(body.booking.bookingdates.checkin).to.eql(pm.variables.get(\"checkin\"));\r\n});\r\n\r\n// Chaining: store values only if the booking was really created\r\nif (pm.response.code === 200 || pm.response.code === 201) {\r\n    const body = pm.response.json();\r\n    pm.environment.set(\"bookingID\", body.bookingid);\r\n    pm.environment.set(\"bookingFirstname\", body.booking.firstname);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"firstname\": \"{{firstname}}\",\r\n  \"lastname\": \"{{lastname}}\",\r\n  \"totalprice\": {{totalprice}},\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": { \"checkin\": \"{{checkin}}\", \"checkout\": \"{{checkout}}\" },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get booking by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst bookingSchema = {\r\n    type: \"object\",\r\n    required: [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],\r\n    properties: {\r\n        firstname:   { type: \"string\" },\r\n        lastname:    { type: \"string\" },\r\n        totalprice:  { type: \"number\" },\r\n        depositpaid: { type: \"boolean\" },\r\n        bookingdates: {\r\n            type: \"object\",\r\n            required: [\"checkin\", \"checkout\"],\r\n            properties: {\r\n                checkin:  { type: \"string\" },\r\n                checkout: { type: \"string\" }\r\n            }\r\n        },\r\n        additionalneeds: { type: \"string\" }\r\n    }\r\n};\r\n\r\npm.test(\"Response matches booking schema\", () => {\r\n    pm.response.to.have.jsonSchema(bookingSchema);\r\n});\r\n\r\npm.test(\"Returns the booking we created\", () => {\r\n    const body = pm.response.json();\r\n    pm.expect(body.firstname).to.eql(pm.environment.get(\"bookingFirstname\"));\r\n});\r\n\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingID}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingID}}"
              ]
            }
          },
          "response": []
        },
